+"""创作平台数据中心：读取本账号近 N 条笔记 + 首页数据总览，用于账号画像自动生成。
+
+2026-10 实测（新版创作平台，路由已改为 /new/ 前缀）：
+- 笔记管理：https://creator.xiaohongshu.com/new/note-manager
+  列表元素 [class*="note-card"]，innerText 结构：
+    [置顶]\n[仅自己可见]\n标题\nYYYY-MM-DD HH:MM\n浏览\n评论\n点赞\n收藏\n分享
+- 首页 https://creator.xiaohongshu.com/new/home 正文含：
+  账号名/粉丝数/获赞与收藏/近7日数据总览/最新笔记标题
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import time
+from typing import Any
+
+from .cdp import Page
+
+logger = logging.getLogger(__name__)
+
+NOTE_MANAGER_URL = "https://creator.xiaohongshu.com/new/note-manager"
+HOME_URL = "https://creator.xiaohongshu.com/new/home"
+
+# 从 note-card DOM 提取笔记列表
+_EXTRACT_NOTES_JS = """
+(() => {
+    const cards = document.querySelectorAll('[class*="note-card"]');
+    const notes = [];
+    const seen = new Set();
+    cards.forEach(card => {
+        const text = (card.innerText || '').trim();
+        if (!text || seen.has(text)) return;
+        seen.add(text);
+        const lines = text.split('\\n').map(s => s.trim()).filter(Boolean);
+        if (lines.length < 3) return;
+        // 过滤掉"置顶"/"仅自己可见"标记，找到日期行定位标题
+        let pinned = false, private_ = false;
+        const rest = [];
+        for (const ln of lines) {
+            if (ln === '置顶') { pinned = true; continue; }
+            if (ln === '仅自己可见') { private_ = true; continue; }
+            rest.push(ln);
+        }
+        // 找日期行（YYYY-MM-DD）
+        const di = rest.findIndex(l => /^\\d{4}-\\d{2}-\\d{2}/.test(l));
+        if (di < 1) return;
+        const title = rest.slice(0, di).join(' ');
+        const nums = rest.slice(di + 1).filter(l => /^[\\d,]+$/.test(l)).map(l => parseInt(l.replace(/,/g, ''), 10));
+        notes.push({
+            title: title.slice(0, 60),
+            time: rest[di],
+            pinned: pinned,
+            private: private_,
+            views: nums[0] !== undefined ? nums[0] : '',
+            likes: nums[2] !== undefined ? nums[2] : '',
+            collects: nums[3] !== undefined ? nums[3] : '',
+            comments: nums[4] !== undefined ? nums[4] : '',
+        });
+    });
+    // 按 标题+日期 去重（同一条笔记可能因"仅自己可见"标记被解析成两条）
+    const dedup = new Map();
+    for (const n of notes) {
+        const key = n.title + '|' + n.time;
+        if (!dedup.has(key) || n.private) dedup.set(key, n);
+    }
+    const final = Array.from(dedup.values());
+    return JSON.stringify({ count: final.length, notes: final.slice(0, 60) });
+})()
+"""
+
+_EXTRACT_HOME_JS = """
+(() => {
+    const text = (document.body.innerText || '').slice(0, 8000);
+    return JSON.stringify({ url: location.href, text: text });
+})()
+"""
+
+
+def get_creator_notes(page: Page, max_count: int = 20, scroll_rounds: int = 5) -> dict[str, Any]:
+    """读取创作平台笔记管理页，返回近 N 条笔记及数据。"""
+    try:
+        page.navigate(NOTE_MANAGER_URL)
+        page.wait_for_load(timeout=40)
+        time.sleep(4)
+
+        for _ in range(scroll_rounds):
+            page.evaluate("window.scrollBy(0, 1500)")
+            time.sleep(1.2)
+
+        raw = page.evaluate(_EXTRACT_NOTES_JS)
+        data = json.loads(raw or "{}")
+        notes = (data.get("notes") or [])[:max_count]
+        if notes:
+            return {"success": True, "url": NOTE_MANAGER_URL, "total": data.get("count"), "notes": notes}
+        return {"success": False, "error": "笔记管理页未提取到笔记（页面结构可能已变化）"}
+    except Exception as e:  # noqa: BLE001
+        logger.warning("笔记管理页读取失败: %s", e)
+        return {"success": False, "error": str(e)}
+
+
+def get_home_snapshot(page: Page) -> dict[str, Any]:
+    """读取创作平台首页正文（账号名/粉丝/获赞收藏/近7日数据总览），供 AI 总结。"""
+    try:
+        page.navigate(HOME_URL)
+        page.wait_for_load(timeout=40)
+        time.sleep(4)
+        raw = page.evaluate(_EXTRACT_HOME_JS)
+        data = json.loads(raw or "{}")
+        text = (data.get("text") or "").strip()
+        if text and "创作服务平台" in text:
+            return {"success": True, "url": data.get("url"), "text": text}
+        return {"success": False, "error": "首页内容异常"}
+    except Exception as e:  # noqa: BLE001
+        logger.warning("首页读取失败: %s", e)
+        return {"success": False, "error": str(e)}
+
+
+def get_datacenter_snapshot(page: Page) -> dict[str, Any]:
+    """兼容旧接口名：数据中心现以首页数据总览代替。"""
+    return get_home_snapshot(page)
