--- /dev/null
+++ b/scripts/xhs/image_previews.js
@@ -0,0 +1,20 @@
+(() => {
+  const rows = [...document.querySelectorAll('.img-preview-area .pr')].filter(
+    row => row.getBoundingClientRect().width && getComputedStyle(row).visibility !== 'hidden'
+  );
+  return rows.map(row => {
+    const image = row.querySelector('img:not([class*="icon"])');
+    let source = image?.currentSrc || image?.src;
+    if (!source) {
+      for (const el of [row, ...row.querySelectorAll('[style*="background"]')]) {
+        const match = /^url\(["']?(.*?)["']?\)$/.exec(getComputedStyle(el).backgroundImage);
+        if (match) { source = match[1]; break; }
+      }
+    }
+    if (!source) return '';
+    // Keep long data URLs and signed media URLs inside the page.
+    const ids = window.__xhsAssistantPreviewIds ||= new Map();
+    if (!ids.has(source)) ids.set(source, crypto.randomUUID());
+    return ids.get(source);
+  });
