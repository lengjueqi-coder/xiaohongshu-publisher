+    const url = p.url || origin;
+    if (new URL(url).origin !== origin) throw new Error('发布地址不属于所选平台');
+    const tab = await chrome.tabs.create({url,active:true});
+    await waitForTabComplete(tab.id,null,30000);
+    return {id:tab.id};
+  }
+  const tab = await chrome.tabs.get(Number(p.tab_id));
+  if (!owns(tab)) throw new Error('官方标签页已经关闭或切换了平台，请重新连接');
+  if (p.action === 'focus') {
+    await chrome.tabs.update(tab.id,{active:true});
+    await chrome.windows.update(tab.windowId,{focused:true});
+    return true;
+  }
+  if (p.action === 'evaluate') {
+    const results = await chrome.scripting.executeScript({target:{tabId:tab.id},world:'MAIN',func:async expression=>{
+      try {return {value:await (0,eval)(expression)};} catch(e){return {error:e.message};}
+    },args:[p.expression]});
+    const r=results[0]?.result;
+    if (!r || r.error) throw new Error(r?.error || '页面未返回结果');
+    return r.value;
+  }
+  const target={tabId:tab.id};
+  await chrome.debugger.attach(target,'1.3');
+  try {
+    if (p.action === 'click') {
+      const point={x:Number(p.x),y:Number(p.y),button:'left',clickCount:1};
+      await chrome.debugger.sendCommand(target,'Input.dispatchMouseEvent',{type:'mousePressed',...point});
+      await chrome.debugger.sendCommand(target,'Input.dispatchMouseEvent',{type:'mouseReleased',...point});
+      return true;
+    }
+    if (p.action === 'screenshot') {
+      return await chrome.debugger.sendCommand(target,'Page.captureScreenshot',{format:'png',captureBeyondViewport:false});
+    }
+    if (p.action === 'files') {
+      const result=await chrome.debugger.sendCommand(target,'Runtime.evaluate',{expression:p.expression,returnByValue:false});
+      const objectId=result.result?.objectId;
+      if (!objectId || result.exceptionDetails) throw new Error('找不到官方文件上传控件');
+      await chrome.debugger.sendCommand(target,'DOM.setFileInputFiles',{objectId,files:p.files});
+      await chrome.debugger.sendCommand(target,'Runtime.releaseObject',{objectId});
+      return true;
+    }
+    if (p.action === 'insert_text') {
+      await chrome.debugger.sendCommand(target,'Input.insertText',{text:p.text});
+      return true;
+    }
+    if (p.action === 'key') {
+      const keys={SelectAll:{key:'a',code:'KeyA',modifiers:4,commands:['selectAll']},Enter:{key:'Enter',code:'Enter',windowsVirtualKeyCode:13},Escape:{key:'Escape',code:'Escape',windowsVirtualKeyCode:27},Space:{key:' ',code:'Space',windowsVirtualKeyCode:32},Backspace:{key:'Backspace',code:'Backspace',windowsVirtualKeyCode:8}};
+      const key=keys[p.key]; if (!key) throw new Error('不支持的按键');
+      await chrome.debugger.sendCommand(target,'Input.dispatchKeyEvent',{type:'keyDown',...key});
+      await chrome.debugger.sendCommand(target,'Input.dispatchKeyEvent',{type:'keyUp',...key});
+      return true;
+    }
+    throw new Error('不支持的页面操作');
+  } finally {await chrome.debugger.detach(target).catch(()=>{});}
+}
