+# ========== 整条笔记的节奏控制 ==========
+class Pacer:
+    """把一条笔记的总耗时控制在用户设定的目标区间内。
+
+    关键点：不是平均分配。每个检查点只领取"剩余时间 / 剩余检查点"的一个随机
+    倍数，再叠加打字、停顿，因此快慢不规律，更像真人。
+    """
+
+    def __init__(self, min_seconds=40.0, max_seconds=90.0, cap_seconds=None,
+                 test=False, checkpoints=8):
+        self.test = bool(test)
+        low = max(15.0, float(min_seconds or 40))
+        high = max(low, float(max_seconds or low))
+        self.target = low if self.test else random.uniform(low, high)
+        self.cap = float(cap_seconds) if cap_seconds else max(self.target * 2.5, self.target + 30)
+        self.cap = max(self.target, self.cap)
+        self.started = time.monotonic()
+        self.left = max(1, int(checkpoints))
+
+    def elapsed(self) -> float:
+        return time.monotonic() - self.started
+
+    def remaining(self) -> float:
+        return max(0.0, self.target - self.elapsed())
+
+    def checkpoint(self, label: str = "", weight: float = 1.0) -> float:
+        """在一个步骤之间停顿，消耗掉本步骤应分到的时间。"""
+        if self.test:
+            sleep_random(120, 320)
+            return 0.0
+        remaining = self.remaining()
+        if remaining <= 0.05:
+            sleep_random(200, 600)
+            return 0.0
+        share = remaining / max(1, self.left) * max(0.1, weight)
+        self.left = max(0, self.left - 1)
+        pause = random.uniform(0.35, 1.55) * share
+        room = max(0.0, self.cap - self.elapsed())
+        pause = max(0.0, min(pause, remaining, room))
+        time.sleep(pause)
+        return pause
+
+    def typing_delay_ms(self, chars: int) -> int:
+        """按剩余预算反推每个字的键入间隔，并夹在像真人的区间内。"""
+        if self.test:
+            return 25
+        if chars <= 0:
+            return 120
+        reserve = max(4.0, self.remaining() * 0.25)
+        budget = max(0.0, self.remaining() - reserve)
+        per_char = budget / chars * 1000.0
+        return int(max(70, min(260, per_char)))
+
+    def finish(self) -> None:
+        """收尾：若还有目标时间，用一个"再看一眼"的停顿补齐。"""
+        if self.test:
+            return
+        remaining = min(self.remaining(), max(0.0, self.cap - self.elapsed()))
+        if remaining > 0.3:
+            time.sleep(random.uniform(remaining * 0.5, remaining * 0.9))
+
+
+PACER = Pacer(test=True)
+
+
+def configure_pace(min_seconds=40, max_seconds=90, cap_seconds=None, test=False) -> Pacer:
+    global PACER
+    PACER = Pacer(min_seconds, max_seconds, cap_seconds, test)
+    return PACER
+
+
+def configure_pace_from_env() -> Pacer:
+    """由服务端通过环境变量传入节奏参数；未传时使用默认 40–90 秒。"""
+
+    def number(name, default):
+        try:
+            return float(os.environ.get(name) or default)
+        except (TypeError, ValueError):
+            return float(default)
+
+    low = number("XHS_PACE_MIN", 40)
+    high = number("XHS_PACE_MAX", 90)
+    cap = number("XHS_PACE_CAP", 0) or None
+    test = str(os.environ.get("XHS_PACE_TEST") or "").strip().lower() in {"1", "true", "yes"}
+    return configure_pace(min(low, high), max(low, high), cap, test)
+
+
