+// Explicit tab routing prevents one platform or Chrome profile from taking over another.
+const PLATFORM_ORIGINS = {workbench:'http://127.0.0.1:5818',douyin:'https://creator.douyin.com',channels:'https://channels.weixin.qq.com'};
+async function platformCommand(p) {
+  const origin = PLATFORM_ORIGINS[p.platform];
+  if (!origin) throw new Error('不支持的平台');
+  const owns = t => {try{return new URL(t.url).origin === origin;}catch{return false;}};
+  if (p.action === 'tabs') {
+    return (await chrome.tabs.query({})).filter(owns).map(t=>({id:t.id,url:t.url.split('?')[0],title:t.title,active:t.active}));
+  }
